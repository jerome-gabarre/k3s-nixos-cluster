{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Mise à jour des packages NixOS (format pkgs.nom_version)",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[a-z-]+))?\\s+package\\s*=\\s*pkgs\\.[a-zA-Z0-9]+_(?<currentValue>[0-9_]+);"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}\n    package = pkgs.k3s_{{{replace '.' '_' newValue}}};",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "groupName": "FluxCD ecosystem",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/^ghcr\\.io/fluxcd//"
      ]
    },
    {
      "matchPackageNames": [
        "longhornio/longhorn-manager",
        "longhornio/longhorn-ui",
        "longhornio/longhorn-engine",
        "longhornio/longhorn-instance-manager"
      ],
      "groupName": "Longhorn storage",
      "automerge": false,
      "description": "Protection du stockage : nécessite une validation manuelle et une vérification des réplicas."
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/webtop"],
      "versioning": "loose",
      "description": "Permet de gérer les tags personnalisés comme ceux de linuxserver.io"
    },
    {
      "matchDatasources": ["github-actions"],
      "automerge": true,
      "groupName": "GitHub Actions"
    }
  ]
}
