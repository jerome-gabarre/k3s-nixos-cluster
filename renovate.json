{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "flux": {
    "fileMatch": ["^k8s/.+\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["^k8s/.+\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["^k8s/.+\\.yaml$"]
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.nix$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+.*version\\s*=\\s*\"(?<currentValue>.*?)\""
      ]
    }
  ]
}